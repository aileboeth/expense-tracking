    <string name="step_lock">在最近任务里锁住「记账」</string>
    <string name="step_lock_where">打开最近任务（多任务）界面，找到记账的卡片，下拉或长按后点「锁定」。一键清理时就不会把它清掉。</string>
    <string name="step_autostart">允许自启动</string>
    <string name="step_xiaomi_autostart">安全中心 → 应用管理 → 权限 → 自启动管理，打开「记账」。</string>
    <string name="step_xiaomi_battery">省电策略选「无限制」</string>
    <string name="step_xiaomi_battery_where">设置 → 应用设置 → 应用管理 → 记账 → 省电策略 → 无限制。</string>
    <string name="step_launch_manual">应用启动管理改成手动</string>
    <string name="step_huawei_where">设置 → 应用和服务 → 应用启动管理 → 记账：关掉「自动管理」，在弹出的窗口里打开「允许自启动」「允许关联启动」「允许后台活动」。</string>
    <string name="step_honor_where">设置 → 应用 → 应用启动管理 → 记账：关掉「自动管理」，打开「允许自启动」「允许关联启动」「允许后台活动」。</string>
    <string name="step_oppo_autostart">设置 → 应用 → 自启动管理（或 手机管家 → 权限隐私 → 自启动管理），打开「记账」。</string>
    <string name="step_background">允许后台运行</string>
    <string name="step_oppo_background">设置 → 电池 → 更多设置 / 应用耗电管理 → 记账：打开「允许后台运行」，关掉「智能限制」类选项。</string>
    <string name="step_vivo_power">允许后台高耗电</string>
    <string name="step_vivo_power_where">设置 → 电池 → 后台耗电管理 → 记账 → 允许后台高耗电。</string>
    <string name="step_vivo_autostart">i管家 → 应用管理 → 权限管理 → 自启动（或 设置 → 应用与权限 → 权限管理 → 自启动），打开「记账」。</string>
    <string name="step_vivo_update">App 更新后打开一次</string>
    <string name="step_vivo_update_where">vivo 在 App 更新后不会自动重新连接通知监听。更新完打开一次记账就好，App 会自己重连。</string>
    <string name="step_samsung_battery">电池改成「不受限制」</string>
    <string name="step_samsung_battery_where">设置 → 应用程序 → 记账 → 电池 → 不受限制。</string>
    <string name="step_samsung_sleep">不要放进「深度休眠应用」</string>
    <string name="step_samsung_sleep_where">设置 → 电池 → 后台使用限制：确认记账不在「休眠应用程序」「深度休眠应用程序」里。</string>
    <string name="step_meizu_background">手机管家 → 权限管理 → 后台管理 → 记账 → 允许后台运行。</string>
    <string name="step_battery_opt">关闭电池优化</string>
    <string name="step_battery_opt_where">设置 → 应用 → 记账 → 电池：选「不优化」或「不受限制」。</string>
    <string name="step_generic_bg">允许自启动 / 后台运行</string>
    <string name="step_generic_bg_where">如果系统有「自启动」「后台运行」之类的开关，给记账打开。</string>
</resources>
