<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Downloaded update APKs. -->
    <cache-path name="update" path="update/" />
    <!-- Photo the camera app writes before it is shrunk into the attachments. -->
    <cache-path name="camera" path="camera/" />
    <!-- Diagnostics report handed to the share sheet. -->
    <cache-path name="diag" path="diag/" />
    <!-- Monthly recap cards handed to the share sheet. -->
    <cache-path name="share" path="share/" />
    <!-- Receipt photos / invoice files, shared read-only with a viewer app when opened. -->
    <files-path name="attachments" path="attachments/" />
</paths>
